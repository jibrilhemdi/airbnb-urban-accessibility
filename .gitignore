# Keep directory placeholders and small metadata under version control.
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!outputs/figures/.gitkeep
!outputs/tables/.gitkeep
!data/metadata/*.json
!data/metadata/*.csv

