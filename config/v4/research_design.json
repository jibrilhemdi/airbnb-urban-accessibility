    {
      "id": "RQ1",
      "text": "How do matched Euclidean and walking-network accessibility representations differ within each city?"
    },
    {
      "id": "RQ2",
      "text": "What predictive accessibility information remains conditional on the qualified baseline X and housing context H?"
    },
    {
      "id": "RQ3",
      "text": "How do geographic versus random validation and cross-city differences change prediction error and accessibility comparisons?"
    },
    {
      "id": "RQ4",
      "text": "How do held-out network gains vary across externally measured housing contexts within and between cities?"
    }
